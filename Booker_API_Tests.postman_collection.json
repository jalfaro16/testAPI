  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Loging",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Validar que el servidor responda con éxito\r",
                  "pm.test(\"Status code es 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Extraer el token y guardarlo en el Environment\r",
                  "const respuesta = pm.response.json();\r",
                  "\r",
                  "if (respuesta.token) {\r",
                  "    pm.environment.set(\"token\", respuesta.token);\r",
                  "    console.log(\"Token capturado y guardado: \" + respuesta.token);\r",
                  "} else {\r",
                  "    pm.designError(\"El campo 'token' no viene en la respuesta. Revisa las credenciales.\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\" : \"admin\",\r\n    \"password\" : \"password123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Booking",
      "item": [
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// --- 1. VALIDACIÓN DE CÓDIGO DE ESTADO ---\r",
                  "pm.test(\"Status code es 200 - OK\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// --- 2. VALIDACIÓN DE TIEMPO DE RESPUESTA (SLA) ---\r",
                  "// Validamos que la API sea rápida. Si tarda más de 800ms, la prueba fallará.\r",
                  "pm.test(\"El tiempo de respuesta es menor a 800ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(800);\r",
                  "});\r",
                  "\r",
                  "// --- 3. VALIDACIÓN DE ESQUEMA JSON (Contract Testing) ---\r",
                  "// Definimos la estructura exacta que DEBE tener la respuesta.\r",
                  "const reservaSchema = {\r",
                  "    \"type\": \"object\",\r",
                  "    \"required\": [\"bookingid\", \"booking\"],\r",
                  "    \"properties\": {\r",
                  "        \"bookingid\": { \"type\": \"number\" },\r",
                  "        \"booking\": {\r",
                  "            \"type\": \"object\",\r",
                  "            \"required\": [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\"],\r",
                  "            \"properties\": {\r",
                  "                \"firstname\": { \"type\": \"string\" },\r",
                  "                \"lastname\": { \"type\": \"string\" },\r",
                  "                \"totalprice\": { \"type\": \"number\" },\r",
                  "                \"depositpaid\": { \"type\": \"boolean\" },\r",
                  "                \"bookingdates\": {\r",
                  "                    \"type\": \"object\",\r",
                  "                    \"required\": [\"checkin\", \"checkout\"],\r",
                  "                    \"properties\": {\r",
                  "                        \"checkin\": { \"type\": \"string\" },\r",
                  "                        \"checkout\": { \"type\": \"string\" }\r",
                  "                    }\r",
                  "                },\r",
                  "                \"additionalneeds\": { \"type\": \"string\" }\r",
                  "            }\r",
                  "        }\r",
                  "    }\r",
                  "};\r",
                  "\r",
                  "// Validamos el contrato usando la librería integrada de Postman\r",
                  "pm.test(\"El esquema JSON de la respuesta es válido\", function () {\r",
                  "    pm.response.to.have.jsonSchema(reservaSchema);\r",
                  "});\r",
                  "\r",
                  "\r",
                  "// --- 4. EXTRACCIÓN DE DATOS (Mantenemos la lógica anterior) ---\r",
                  "const respuesta = pm.response.json();\r",
                  "if (respuesta.bookingid) {\r",
                  "    pm.environment.set(\"booking_id\", respuesta.bookingid);\r",
                  "    console.log(\"Booking ID guardado con éxito: \" + respuesta.bookingid);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"firstname\" : \"Jim\",\r\n    \"lastname\" : \"Brown\",\r\n    \"totalprice\" : 111,\r\n    \"depositpaid\" : true,\r\n    \"bookingdates\" : {\r\n        \"checkin\" : \"2026-01-01\",\r\n        \"checkout\" : \"2026-01-02\"\r\n    },\r\n    \"additionalneeds\" : \"Breakfast\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/booking",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Validar código de estado\r",
                  "pm.test(\"Status code es 200 - Reserva Actualizada\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// 2. Validar que los datos cambiaron en la respuesta (Data Verification)\r",
                  "const respuesta = pm.response.json();\r",
                  "\r",
                  "pm.test(\"El nombre se actualizó correctamente a 'James'\", function () {\r",
                  "    pm.expect(respuesta.firstname).to.eql(\"James\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"El precio total se actualizó correctamente a 150\", function () {\r",
                  "    pm.expect(respuesta.totalprice).to.eql(150);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"firstname\" : \"James\",\r\n    \"lastname\" : \"Brown\",\r\n    \"totalprice\" : 150,\r\n    \"depositpaid\" : true,\r\n    \"bookingdates\" : {\r\n        \"checkin\" : \"2026-01-01\",\r\n        \"checkout\" : \"2026-01-02\"\r\n    },\r\n    \"additionalneeds\" : \"Breakfast\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/booking/{{booking_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "booking",
                "{{booking_id}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// El servidor responde con 201 Created cuando el borrado es exitoso en esta API\r",
                  "pm.test(\"Status code es 201 - Registro Eliminado\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "// Aserción de rendimiento\r",
                  "pm.test(\"Tiempo de respuesta menor a 800ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(800);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/booking/{{booking_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "booking",
                "{{booking_id}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
